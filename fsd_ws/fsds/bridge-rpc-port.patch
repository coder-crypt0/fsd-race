diff --git a/ros2/src/fsds_ros2_bridge/include/fsd_rpc_port.hpp b/ros2/src/fsds_ros2_bridge/include/fsd_rpc_port.hpp
new file mode 100644
--- /dev/null
+++ b/ros2/src/fsds_ros2_bridge/include/fsd_rpc_port.hpp
@@ -0,0 +1,21 @@
+#pragma once
+#include <cerrno>
+#include <cstdint>
+#include <cstdlib>
+#include <stdexcept>
+
+// Project-local override: do not alter the host's reserved TCP ranges.
+inline uint16_t fsd_rpc_port(uint16_t default_port) {
+    const char * text = std::getenv("FSD_RPC_PORT");
+    if (!text) { return default_port; }
+    char * end = nullptr;
+    errno = 0;
+    const long port = std::strtol(text, &end, 10);
+    if (errno || end == text || *end != '\0' || port < 1 || port > 65535) {
+        throw std::invalid_argument("FSD_RPC_PORT must be an integer from 1 to 65535");
+    }
+    return static_cast<uint16_t>(port);
+}
+
+// Both the control/sensor client and the separate camera process use this port.
+// With the variable unset, upstream behavior is unchanged.
